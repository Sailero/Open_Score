{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open-SCORE v5.1: 启动或恢复六任务",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "${workspaceFolder}\\.vscode\\start-v5.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\Open-SCORE"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": true
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "warn"
      }
    },
    {
      "label": "Open-SCORE v5.1: 实时进度（仅监控）",
      "type": "process",
      "command": "D:\\Software\\Anaconda\\envs\\torch310\\python.exe",
      "args": ["-X", "utf8", "-u", "-m", "open_score.research_v5.orchestrate", "watch", "--run-dir", "outputs/v5_parallel/v5_20260907_main"],
      "options": {"cwd": "${workspaceFolder}\\Open-SCORE"},
      "presentation": {"reveal": "always", "focus": true, "panel": "dedicated", "clear": false},
      "problemMatcher": [],
      "runOptions": {"instanceLimit": 1}
    }
  ]
}
