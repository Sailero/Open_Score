# Experiment data (keep reports and figures)
*.csv
*.tsv
*.parquet

# Model weights and arrays
*.pt
*.pth
*.ckpt
*.pkl
*.npy
*.npz
*.h5
*.log

# Python / packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Runtime junk
*.lock
.DS_Store
*.swp
.idea/
.vscode/

# Atomic checkpoint and experiment control files
*.pt.pending
*.pt.tmp
stop.request
eval.stop.request

# Local diagnostic trajectories and process handles
*.json.gz
*.pid

# Per-run runtime state (rewritten continuously; not results)
resource.json
resource_retry.json
failure.json
scheduler.*.json
queue.*.json
# Clone-local environments and caches (created by scripts/setup_farm.sh)
envs/
!Open-SCORE/outputs/main0928/
!Open-SCORE/outputs/main0928/run_all.sh
!Open-SCORE/outputs/main0928/*.md
!Open-SCORE/outputs/main0928/imported/
!Open-SCORE/outputs/main0928/imported/**
!Open-SCORE/outputs/main0928/imported/**/*.pt
!Open-SCORE/outputs/main0928/imported/**/*.csv.gz
!Open-SCORE/outputs/main0928/imported/**/*.json

# Vendored simulators: keep source, drop local build trees
third_party/**/build/
third_party/**/*.egg-info/
