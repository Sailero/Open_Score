# Experiment data (keep reports and figures)
*.csv
*.tsv
*.parquet
*.jsonl
*.jsonl.gz

# Model weights and arrays
*.pt
*.pth
*.ckpt
*.pkl
*.npy
*.npz
*.h5
*.log

# Python / packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Runtime junk
*.lock
.DS_Store
*.swp
.idea/
.vscode/

# Atomic checkpoint and experiment control files
*.pt.pending
*.pt.tmp
stop.request
eval.stop.request

# Local diagnostic trajectories and process handles
*.json.gz
*.pid

# Per-run runtime state (rewritten continuously; not results)
resource.json
resource_retry.json
failure.json
scheduler.*.json
queue.*.json
Open-SCORE/outputs/*/smacv2/scenes/manifest.json
# Historical raw data and models remain local; publish the sole report,
# compact provenance/result index and necessary existing result figures.
backup/*
!backup/README.md
!backup/experiment.json
!backup/had/
backup/had/*
!backup/had/extra_variants/
backup/had/extra_variants/*
!backup/had/extra_variants/figures/
backup/had/extra_variants/figures/*
!backup/had/extra_variants/figures/*.png
!backup/had/historical_protocols/
backup/had/historical_protocols/*
!backup/had/historical_protocols/figures/
backup/had/historical_protocols/figures/*
!backup/had/historical_protocols/figures/*.png
!backup/smacv2/
backup/smacv2/*
!backup/smacv2/figures/
backup/smacv2/figures/*
!backup/smacv2/figures/*.png
*.aux
*.bbl
*.blg
*.out
*.toc
*.xdv
*.synctex.gz
evaluation.json

# Full timing calls stay local; publish aggregates and figures instead.
Open-SCORE/outputs/main/had/decision_timing.json
